import { NextResponse } from "next/server";
import OpenAI from "openai";

function normalizePhone(phone: string) {
  return phone
    .replace(/\s/g, "")
    .replace(/-/g, "")
    .replace(/\//g, "")
    .replace(/^0049/, "+49")
    .replace(/^0/, "+49");
}

async function saveAppointment(leadId: number, appointmentText: string) {
  if (!appointmentText.trim()) return;

  await fetch(`${process.env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/lead_appointments`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      apikey: process.env.SUPABASE_SERVICE_ROLE_KEY!,
      Authorization: `Bearer ${process.env.SUPABASE_SERVICE_ROLE_KEY}`,
      Prefer: "return=representation",
    },
    body: JSON.stringify({
      lead_id: leadId,
      appointment_text: appointmentText,
      status: "erkannt",
      source: "ki",
    }),
  });
}

export async function POST(req: Request) {
  try {
    const body = await req.json();

    const openai = new OpenAI({
      apiKey: process.env.OPENAI_API_KEY,
    });

    const completion = await openai.chat.completions.create({
      model: "gpt-4o-mini",
      temperature: 0.4,
      messages: [
        {
          role: "system",
          content: `
Du bist ein erfahrener KI-Assistent für Handwerksbetriebe in Deutschland.

Analysiere Kundenanfragen intelligent und antworte ausschließlich als valides JSON.

Erkenne zusätzlich, ob der Kunde einen Termin, Zeitraum oder eine Verfügbarkeit nennt.

Beispiele:
- "Mittwoch um 14 Uhr passt" => appointment_detected true
- "Ich bin morgen ab 15 Uhr zuhause" => appointment_detected true
- "Können Sie nächste Woche kommen?" => appointment_detected true
- "Meine Heizung ist kaputt" => appointment_detected false

Antworte exakt in diesem JSON-Format:

{
  "customer_name": "",
  "phone": "",
  "email": "",
  "city": "",
  "raw_message": "",
  "trade": "",
  "summary": "",
  "urgency": "",
  "site_visit_needed": true,
  "missing_info": [],
  "suggested_reply": "",
  "status": "neu",
  "appointment_detected": false,
  "appointment_text": ""
}
`,
        },
        {
          role: "user",
          content: `
Formulardaten:
Name: ${body.customer_name || ""}
Telefon: ${body.phone || ""}
E-Mail: ${body.email || ""}
Ort: ${body.city || ""}

Kundenanfrage:
${body.message || ""}
`,
        },
      ],
    });

    const raw = completion.choices[0]?.message?.content || "{}";
    const cleaned = raw.replace(/```json/g, "").replace(/```/g, "").trim();

    let parsed: any;

    try {
      parsed = JSON.parse(cleaned);
    } catch {
      return NextResponse.json(
        {
          error: "GPT hat kein valides JSON geliefert",
          raw,
          cleaned,
        },
        { status: 500 }
      );
    }

    const missingInfo: string[] = Array.isArray(parsed.missing_info)
      ? parsed.missing_info
      : [];

    const finalData = {
      customer_name: body.customer_name || parsed.customer_name || "",
      phone: normalizePhone(body.phone || parsed.phone || ""),
      email: body.email || parsed.email || "",
      city: body.city || parsed.city || "",
      raw_message: body.message || "",
      trade: parsed.trade || "Allgemein",
      summary: parsed.summary || body.message || "",
      urgency: parsed.urgency || "mittel",
      site_visit_needed:
        typeof parsed.site_visit_needed === "boolean"
          ? parsed.site_visit_needed
          : true,
      missing_info: missingInfo,
      suggested_reply:
        parsed.suggested_reply ||
        "Vielen Dank für Ihre Anfrage. Wir prüfen Ihr Anliegen und melden uns zeitnah bei Ihnen.",
      status: parsed.status || "neu",
    };

    const appointmentDetected = parsed.appointment_detected === true;
    const appointmentText = parsed.appointment_text || "";

    const searchRes = await fetch(
      `${process.env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/leads?phone=eq.${encodeURIComponent(
        finalData.phone
      )}&status=neq.erledigt&order=id.desc&limit=1`,
      {
        method: "GET",
        headers: {
          apikey: process.env.SUPABASE_SERVICE_ROLE_KEY!,
          Authorization: `Bearer ${process.env.SUPABASE_SERVICE_ROLE_KEY}`,
        },
      }
    );

    if (!searchRes.ok) {
      const errText = await searchRes.text();

      return NextResponse.json(
        {
          error: "Fehler beim Suchen bestehender Aufträge",
          details: errText,
        },
        { status: 500 }
      );
    }

    const existingLeads = await searchRes.json();
    const existingLead = existingLeads?.[0];

    if (existingLead) {
      const messageRes = await fetch(
        `${process.env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/lead_messages`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: process.env.SUPABASE_SERVICE_ROLE_KEY!,
            Authorization: `Bearer ${process.env.SUPABASE_SERVICE_ROLE_KEY}`,
            Prefer: "return=representation",
          },
          body: JSON.stringify({
            lead_id: existingLead.id,
            sender: "kunde",
            channel: "web",
            message_text: finalData.raw_message,
          }),
        }
      );

      if (!messageRes.ok) {
        const errText = await messageRes.text();

        return NextResponse.json(
          {
            error: "Fehler beim Speichern der Zusatznachricht",
            details: errText,
          },
          { status: 500 }
        );
      }

      if (appointmentDetected) {
        await saveAppointment(existingLead.id, appointmentText);
      }

      return NextResponse.json({
        ok: true,
        mode: "added_to_existing_lead",
        lead_id: existingLead.id,
        appointment_detected: appointmentDetected,
        appointment_text: appointmentText,
        data: finalData,
      });
    }

    const supabaseRes = await fetch(
      `${process.env.NEXT_PUBLIC_SUPABASE_URL}/rest/v1/leads`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          apikey: process.env.SUPABASE_SERVICE_ROLE_KEY!,
          Authorization: `Bearer ${process.env.SUPABASE_SERVICE_ROLE_KEY}`,
          Prefer: "return=representation",
        },
        body: JSON.stringify(finalData),
      }
    );

    if (!supabaseRes.ok) {
      const errText = await supabaseRes.text();

      return NextResponse.json(
        {
          error: "Supabase Fehler",
          details: errText,
          payload: finalData,
        },
        { status: 500 }
      );
    }

    const insertedLead = await supabaseRes.json();
    const newLead = insertedLead?.[0] || null;

    if (newLead && appointmentDetected) {
      await saveAppointment(newLead.id, appointmentText);
    }

    return NextResponse.json({
      ok: true,
      mode: "new_lead_created",
      lead: newLead,
      appointment_detected: appointmentDetected,
      appointment_text: appointmentText,
      data: finalData,
    });
  } catch (err: any) {
    return NextResponse.json(
      {
        error: "Analyse Fehler",
        details: err.message,
      },
      { status: 500 }
    );
  }
}